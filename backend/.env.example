# ============================================================
# 环境变量模板：复制为 backend/.env 后按实际情况填写
#   cp .env.example .env
# 请勿将真实的 .env 提交到仓库
# ============================================================

# ---------- LLM（通义千问 / DashScope OpenAI 兼容接口）----------
QWEN_MODEL_NAME=qwen-max
QWEN_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---------- 高德地图开放平台（Web 服务 Key）----------
GAODE_API_KEY=your_gaode_web_service_key
GAODE_NEARBY_URL=https://restapi.amap.com/v3/place/around
GAODE_LOCATION_URL=https://restapi.amap.com/v3/place/text

# ---------- RAG：Ollama Embedding + Chroma ----------
# 需先执行：ollama pull nomic-embed-text
EMBEDDINGS_MODEL_NAME=nomic-embed-text
# Chroma 以服务端模式运行：chroma run --path ./chroma_data --port 8081
CHROMA_HOST=localhost
CHROMA_PORT=8081

# ---------- Reranker 模型缓存 ----------
# bge-reranker-large 的本地缓存根目录（知识检索会读取该路径）
# 下载示例：huggingface-cli download BAAI/bge-reranker-large --cache-dir D:/hf_cache/hub
HF_HOME=D:/hf_cache

# ---------- MySQL ----------
# 格式：mysql+pymysql://用户名:密码@主机:端口/数据库名
CONNECTION_STRING=mysql+pymysql://root:your_password@localhost:3306/doctor_db
